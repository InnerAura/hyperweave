{# HyperWeave Tier 3 Metadata Block (Resonant).
   Injected by document.svg.j2 when metadata_tier >= 1.

   v0.3.2 Phase 8c: hardcoded Jinja2 `default('...')` fallbacks removed.
   Every metadata field now sources from context.py — see _base_context()
   in compose/context.py. New fields: hw:variant, hw:stratum, accurate
   theme_category/palette/contrast_ratio/font_stack/etc. #}
  <metadata>
  <hw:artifact id="{{ artifact_id }}" type="{{ frame_type }}" series="{{ series }}" version="{{ version }}"
               xmlns:hw="https://hyperweave.app/hw/v1.0">
    <hw:provenance>
      <hw:generator>HyperWeave Compositor v{{ version }} (InnerAura Labs)</hw:generator>
      <hw:created>{{ created_at }}</hw:created>
      <hw:human-directed>true</hw:human-directed>
    </hw:provenance>
{# performance carries NO default — a missing tier must fail loudly, never
   silently claim the stronger (composite-only) tier. size is the CSS-px
   render size (the root width/height attributes), declared as such because
   frames with a scaled viewBox (diagram, icon) render at a different size
   than their user-unit space — hw:regions below declares its own units. #}
    <hw:spec size="{{ width }}x{{ height }}" size-units="px" performance="{{ performance_tier }}"
             theme="{{ theme_category | xml_escape }}" a11y="WCAG-AA" platform="{{ platform | xml_escape }}"/>
  </hw:artifact>
  <hw:composition xmlns:hw="https://hyperweave.app/hw/v1.0">
    <hw:frame>{{ frame_public | default(frame_type) | xml_escape }}</hw:frame>
    <hw:genome>{{ genome_id | xml_escape }}@{{ version }}</hw:genome>
{% if variant %}    <hw:variant>{{ variant | xml_escape }}</hw:variant>
{% endif %}{% if profile_id %}    <hw:profile>{{ profile_id | xml_escape }}</hw:profile>
{% endif %}{% if stratum %}    <hw:stratum>{{ stratum | xml_escape }}</hw:stratum>
{% endif %}    <hw:slots>
{% for slot in slots | default([]) %}
      <hw:slot zone="{{ slot.zone | xml_escape }}" {% if slot.value %}value="{{ slot.value | xml_escape }}"{% endif %}{% if slot.data %} data="{{ slot.data | xml_escape }}"{% endif %}/>
{% endfor %}
    </hw:slots>
    <hw:environment platform="{{ platform | xml_escape }}" motion="{{ data_hw_motion | xml_escape }}" status="{{ status | xml_escape }}"/>
  </hw:composition>
{% if metadata_tier >= 2 %}
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
           xmlns:dc="http://purl.org/dc/elements/1.1/">
    <rdf:Description>
      <dc:title>{{ title_text | xml_escape }}</dc:title>
      <dc:creator>HyperWeave Compositor v{{ version }} (InnerAura Labs)</dc:creator>
      <dc:date>{{ created_at }}</dc:date>
      <dc:rights>CC BY 4.0</dc:rights>
    </rdf:Description>
  </rdf:RDF>
{% endif %}
{% if metadata_tier >= 3 %}
  <hw:aesthetic xmlns:hw="https://hyperweave.app/hw/v1.0">
{# contrast-ratio is the measured MINIMUM over the named role pairs and
   contrast-worst-pair names which one — a claim with a referent, never a
   single flattering scalar over a multi-role palette. #}
    <hw:chromatic system="{{ genome_id | xml_escape }}" space="oklch"
                  palette="{{ palette | xml_escape }}" contrast-ratio="{{ contrast_ratio }}" contrast-worst-pair="{{ contrast_worst_pair }}"/>
{# rhythm-base names the genome's rhythm token (--dna-rhythm-base) — the phi
   anchor a template MAY consume, never a claim about this artifact's actual
   animation clocks (most durations are template literals or diagram-derived).
   The old ``duration-base`` label implied the latter and was false. #}
    <hw:motion vocabulary="{{ motion_vocabulary | default(motion_id) | xml_escape }}" physics="{{ motion_physics | default('none') | xml_escape }}"
               timing="{{ timing_doctrine }}" rhythm-base="{{ rhythm_base }}"
{# cim-compliant DERIVES from the tier in one seam — an artifact whose motion
   animates a Paint-stage property (dash's stroke-dashoffset) is not
   compositor-inspired-motion compliant, whatever it used to claim. #}
               stagger-regime="{{ motion_stagger_regime | default('contemplative') | xml_escape }}" cim-compliant="{{ 'true' if performance_tier == 'composite-only' else 'false' }}"/>
    <hw:geometry form-language="{{ form_language | xml_escape }}" corner-radius="{{ corner | default('5px') | xml_escape }}"
                 grid="auto" proportional-system="phi"
                 mathematical-basis="golden-ratio" symmetry="bilateral"/>
    <hw:typography stack="{{ font_stack }}" hierarchy="11/18/8"
                   weight-range="500-900" metrics-method="lut"/>
    <hw:material surface="genome-native" depth="{{ material_depth | xml_escape }}" texture="none"/>
  </hw:aesthetic>
{% include "components/chromatic-surface.svg.j2" %}
  <hw:reasoning xmlns:hw="https://hyperweave.app/hw/v1.0">
{# Invariant 14: reasoning is authored prose, so a stray &, <, or > in a
   data/reasoning/*.yaml string would otherwise break the container. escape
   LAST in the chain, after default(). #}
    <hw:intent>{{ reasoning_intent | default('') | xml_escape }}</hw:intent>
    <hw:approach>{{ reasoning_approach | default('') | xml_escape }}</hw:approach>
    <hw:tradeoffs>{{ reasoning_tradeoffs | default('') | xml_escape }}</hw:tradeoffs>
    <hw:constraints-applied>{{ font_constraint | xml_escape }}{% if performance_tier == 'composite-only' %}, cim-compliant{% endif %}, wcag-aa</hw:constraints-applied>
    <hw:spatial-notes>{{ spatial_notes | xml_escape }}</hw:spatial-notes>
  </hw:reasoning>
{% endif %}
{# hw:payload + hw:envelope — emitted at EVERY metadata tier when present:
   the payload IS the artifact's data (data-carrying frames are lossy
   without it), not tier-3 garnish. CDATA bodies are canonical and
   CDATA-safe by construction (core/envelope.py:cdata_safe_json); the
   envelope id is recomputable as sha256 of the payload bytes below. #}
{% if payload_json %}  <hw:payload xmlns:hw="https://hyperweave.app/hw/v1.0" schema="{{ payload_schema }}" media-type="application/json"><![CDATA[{{ payload_json }}]]></hw:payload>
{% endif %}{% if envelope_json %}  <hw:envelope xmlns:hw="https://hyperweave.app/hw/v1.0" format="{{ envelope_format }}" media-type="application/json"><![CDATA[{{ envelope_json }}]]></hw:envelope>
{% endif %}{% if regions_json %}{# regions bboxes live in USER units (the solver's viewBox space), which on a
   scaled frame differs from hw:spec's CSS-px size by the display factor —
   both sides declare their space so a consumer can convert. #}  <hw:regions xmlns:hw="https://hyperweave.app/hw/v1.0" media-type="application/json" units="user" viewbox="0 0 {{ (viewbox_w | default(0) or width) | xml_escape }} {{ (viewbox_h | default(0) or height) | xml_escape }}"><![CDATA[{{ regions_json }}]]></hw:regions>
{% endif %}</metadata>
